{
  "manifest_version": 3,
  "name": "AI Usage Widget - Gemini companion",
  "version": "0.2.0",
  "description": "Reads your Gemini usage meters from your own signed-in Chrome and hands them to the AI Usage Widget on this computer. Nothing leaves your machine.",
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_title": "AI Usage Widget - Gemini companion (click for token settings)",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "permissions": ["alarms", "tabs", "storage"],
  "host_permissions": ["https://gemini.google.com/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "content_scripts": [
    {
      "matches": ["https://gemini.google.com/usage*"],
      "js": ["parse.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
